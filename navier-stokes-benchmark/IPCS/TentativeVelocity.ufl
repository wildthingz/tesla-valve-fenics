# pylint: disable-all
# Define elements
cell = triangle

vElem = VectorElement("P", cell, 2)
fElem = FiniteElement("P", cell, 1)
rElem = FiniteElement("Real", cell, 0)

# Define trial and test functions
u = TrialFunction(vElem)
v = TestFunction(vElem)

# Define coefficients
u_n = Coefficient(vElem)
u_ = Coefficient(vElem)
p_n = Coefficient(fElem)
f  = Coefficient(vElem)
k = Coefficient(rElem)
mu = Coefficient(rElem)
rho = Coefficient(rElem)
n = FacetNormal(cell)
U = 0.5*(u_n + u)

# Define strain-rate tensor
def epsilon(u):
    return sym(nabla_grad(u))

# Define stress tensor
def sigma(u, p):
    return 2*mu*epsilon(u) - p*Identity(len(u))

# Define bilinear and linear forms
eq = rho*dot((u - u_n) / k, v)*dx + \
    rho*dot(dot(u_n, nabla_grad(u_n)), v)*dx \
    + inner(sigma(U, p_n), epsilon(v))*dx \
    + dot(p_n*n, v)*ds - dot(mu*nabla_grad(U)*n, v)*ds \
    - dot(f, v)*dx
a = lhs(eq)
L = rhs(eq)
